local State = {
	Aimbot = false,
	AimSmooth = 24,
	AimRange = 320,
	Speed = 28,
	Jump = 65,
	InfJump = false,
	Noclip = false,
	Esp = false,
	FullBright = false,
	AntiAfk = true,
	SavedCFrame = nil
}

local function GetHum()
	local c = lp.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function GetRoot()
	local c = lp.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function ApplyStats()
	local h = GetHum()
	if h then
		h.WalkSpeed = State.Speed
		h.UseJumpPower = true
		h.JumpPower = State.Jump
	end
end

local function GetBestAimPart()
	local myRoot = GetRoot()
	if not myRoot then return nil end
	local bestPart, bestScore = nil, math.huge
	local center = Vector2.new(Camera.ViewportSize.X * 0.5, Camera.ViewportSize.Y * 0.5)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local targetPart = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and targetPart then
				local dist = (targetPart.Position - myRoot.Position).Magnitude
				if dist <= State.AimRange then
					local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
					local screenDist = onScreen and (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude or (dist * 4)
					local score = screenDist + (dist * 0.35)
					if score < bestScore then
						bestScore = score
						bestPart = targetPart
					end
				end
			end
		end
	end

	return bestPart
end

local NoclipCache = {}
local function RefreshNoclipList()
	table.clear(NoclipCache)
	local c = lp.Character
	if not c then return end
	for _, p in ipairs(c:GetDescendants()) do
		if p:IsA("BasePart") and p.CanCollide then
			table.insert(NoclipCache, p)
		end
	end
end

local function RestoreNoclip()
	for _, p in ipairs(NoclipCache) do
		if p and p.Parent then
			pcall(function() p.CanCollide = true end)
		end
	end
	table.clear(NoclipCache)
end

local EspContainer = Instance.new("Folder")
EspContainer.Name = SCRIPT_TAG .. "_ESP"
EspContainer.Parent = Root

local function ClearEsp()
	for _, v in ipairs(EspContainer:GetChildren()) do
		pcall(function() v:Destroy() end)
	end
end

local function RebuildEsp()
	ClearEsp()
	if not State.Esp then return end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			local hl = Instance.new("Highlight")
			hl.Adornee = plr.Character
			hl.FillColor = Pal.Cyan
			hl.OutlineColor = Pal.Txt
			hl.FillTransparency = 0.65
			hl.OutlineTransparency = 0.12
			hl.Parent = EspContainer
		end
	end
end

local OrigLighting = {
	Brightness = Lighting.Brightness,
	FogEnd = Lighting.FogEnd,
	GlobalShadows = Lighting.GlobalShadows
}

local function SetBright(en)
	State.FullBright = en
	if en then
		Lighting.Brightness = 2.5
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
	else
		Lighting.Brightness = OrigLighting.Brightness
		Lighting.FogEnd = OrigLighting.FogEnd
		Lighting.GlobalShadows = OrigLighting.GlobalShadows
	end
end

