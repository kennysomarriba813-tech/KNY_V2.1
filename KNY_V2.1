local function AddToggle(page, label, def, vipOnly, cb)
	local st = def == true
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, 36)
	row.BackgroundColor3 = Pal.Card
	row.ZIndex = 22
	row.Parent = page
	Rad(row, 8)
	Stroke(row, vipOnly and Pal.Gold or Pal.Border, 1, 0.2)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -72, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 11
	lbl.TextColor3 = vipOnly and Pal.Gold or Pal.Txt
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Text = (vipOnly and "[VIP] " or "") .. label
	lbl.ZIndex = 23
	lbl.Parent = row

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 54, 0, 24)
	btn.Position = UDim2.new(1, -62, 0.5, -12)
	btn.Font = Enum.Font.GothamBlack
	btn.TextSize = 10
	btn.ZIndex = 23
	btn.Parent = row
	Rad(btn, 6)

	local function paint()
		if vipOnly and KeySystem.Tier ~= "VIP" then
			btn.Text = "VIP"
			btn.BackgroundColor3 = Pal.Bg
			btn.TextColor3 = Pal.Gold
			return
		end
		btn.Text = st and "ON" or "OFF"
		btn.BackgroundColor3 = st and Pal.Green or Pal.Card2
		btn.TextColor3 = st and Pal.Bg or Pal.Sub
	end

	paint()
	btn.MouseButton1Click:Connect(function()
		if vipOnly and KeySystem.Tier ~= "VIP" then
			Notify("VIP", "Requiere credencial VIP válida", Pal.Gold, true)
			return
		end
		PlaySfx(SndClick)
		st = not st
		paint()
		if cb then cb(st) end
	end)

	return function(val)
		st = val and true or false
		paint()
	end
end

local function AddSlider(page, label, minV, maxV, defV, cb)
	local val = math.clamp(defV, minV, maxV)
	local box = Instance.new("Frame")
	box.Size = UDim2.new(1, 0, 0, 48)
	box.BackgroundColor3 = Pal.Card
	box.ZIndex = 22
	box.Parent = page
	Rad(box, 8)
	Stroke(box, Pal.Border, 1, 0.2)

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -20, 0, 18)
	lbl.Position = UDim2.new(0, 10, 0, 4)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.TextSize = 10
	lbl.TextColor3 = Pal.Txt
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.ZIndex = 23
	lbl.Parent = box

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, -20, 0, 12)
	track.Position = UDim2.new(0, 10, 0, 27)
	track.BackgroundColor3 = Pal.Bg
	track.ZIndex = 23
	track.Parent = box
	Rad(track, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Pal.Cyan
	fill.ZIndex = 24
	fill.Parent = track
	Rad(fill, 6)

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.ZIndex = 25
	hit.Parent = track

	local function apply(raw)
		val = math.clamp(math.floor(raw + 0.5), minV, maxV)
		local ratio = (val - minV) / math.max(maxV - minV, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		lbl.Text = label .. ": " .. tostring(val)
		if cb then cb(val) end
	end

	apply(val)

	local dragging = false
	local function updateFromX(x)
		local w = math.max(track.AbsoluteSize.X, 1)
		local r = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
		apply(minV + r * (maxV - minV))
	end

	hit.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromX(inp.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(inp)
		if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			updateFromX(inp.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

