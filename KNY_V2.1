	if nearRoot then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.CFrame = nearRoot.CFrame * CFrame.new(0, 0, -4)
		Notify("TP", "Teletransportado a " .. math.floor(bestD) .. " studs", Pal.Green)
