TapBtn.MouseButton1Click:Connect(function()
	PlaySfx(SndClick)
	local now = os.clock()
	if not KeySystem.TapStart then
		KeySystem.TapStart = now
	elseif (now - KeySystem.TapStart) > KeySystem.TapTimeLimit then
		KeySystem.TapCount = 0
		KeySystem.TapStart = now
		Notify("TIEMPO REINICIADO", "Se agotó el tiempo, vuelve a los 35 toques", Pal.Red, true)
	end

	KeySystem.TapCount = math.min(KeySystem.TapCount + 1, KeySystem.TapGoal)
	local rem = math.max(0, math.ceil(KeySystem.TapTimeLimit - (now - KeySystem.TapStart)))
	TapBtn.Text = "TOCAR: " .. KeySystem.TapCount .. " / " .. KeySystem.TapGoal .. "  (" .. rem .. "s)"

	if KeySystem.TapCount >= KeySystem.TapGoal then
		TapBtn.BackgroundColor3 = Pal.Green
		TapBtn.TextColor3 = Pal.Bg
		TapBtn.Text = "35/35 TOQUES COMPLETADOS!"
	end
end)

EnterBtn.MouseButton1Click:Connect(function()
	PlaySfx(SndClick)
	local enteredKey = string.upper(string.gsub(KeyInput.Text, "%s+", ""))
	local enteredPin = string.gsub(PinInput.Text, "%s+", "")
	local enteredAns = tonumber(string.gsub(MathInput.Text, "%s+", ""))

	if enteredKey == "" or enteredPin == "" then
		Notify("DATOS FALTANTES", "Escribe manualmente la Key y su PIN", Pal.Red, true)
		return
	end

	if KeySystem.BurnedKeys[enteredKey] then
		Notify("KEY QUEMADA", "Esa key ya fue usada y destruida", Pal.Red, true)
		return
	end

	local cred = KeySystem.ActiveKeys[enteredKey]
	if not cred then
		Notify("KEY INVÁLIDA", "Key no existe o ya no está activa", Pal.Red, true)
		return
	end

	if enteredPin ~= cred.pin then
		Notify("PIN INCORRECTO", "El PIN no coincide con esa key", Pal.Gold, true)
		return
	end

	local expectedAns = KeySystem.ChallengeA + KeySystem.ChallengeB
	if enteredAns ~= expectedAns then
		NewChallenge()
		MathInput.Text = ""
		MathInput.PlaceholderText = "Reto: " .. KeySystem.ChallengeA .. " + " .. KeySystem.ChallengeB .. " = ?"
		Notify("RETO FALLIDO", "Respuesta incorrecta, se generó un reto nuevo", Pal.Red, true)
		return
	end

	if KeySystem.TapStart and (os.clock() - KeySystem.TapStart) > KeySystem.TapTimeLimit then
		ResetTapCounter("Se acabó el tiempo antes de los 35 toques")
		TapBtn.BackgroundColor3 = Pal.Card2
		TapBtn.TextColor3 = Pal.Gold
		TapBtn.Text = "TOCAR: 0 / 35  (30s)"
		return
	end

	if KeySystem.TapCount < KeySystem.TapGoal then
		Notify("35 TOQUES", "Te faltan toques (" .. KeySystem.TapCount .. "/35)", Pal.Gold, true)
		return
	end

	-- Destruir / quemar la key al usarse
	local tierGranted = cred.tier
	BurnCredential(enteredKey)
	KeySystem.Tier = tierGranted
	KeyInput.Text = ""
	PinInput.Text = ""
	MathInput.Text = ""
	NewChallenge()
	MathInput.PlaceholderText = "Reto: " .. KeySystem.ChallengeA .. " + " .. KeySystem.ChallengeB .. " = ?"

	PlaySfx(SndSuccess)
	KeyWin.Visible = false
	Main.Visible = true
	FloatBtn.Visible = true
	ApplyStats()
	Notify(SCRIPT_NAME, "Key destruida • Acceso " .. tierGranted .. " concedido", Pal.Green)
end)

