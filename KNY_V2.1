local function Notify(title, msg, col, isAlert)
	PlaySfx(isAlert and SndAlert or SndNotify)
	local accent = col or Pal.Cyan

	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 64)
	card.BackgroundColor3 = Pal.Panel
	card.BackgroundTransparency = 0.05
	card.ZIndex = 71
	card.Parent = NotifHolder
	Rad(card, 10)
	Stroke(card, accent, 1.4, 0.1)

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(0, 4, 1, -12)
	bar.Position = UDim2.new(0, 6, 0, 6)
	bar.BackgroundColor3 = accent
	bar.ZIndex = 72
	bar.Parent = card
	Rad(bar, 4)

	local tLbl = Instance.new("TextLabel")
	tLbl.Size = UDim2.new(1, -22, 0, 18)
	tLbl.Position = UDim2.new(0, 16, 0, 7)
	tLbl.BackgroundTransparency = 1
	tLbl.Font = Enum.Font.GothamBlack
	tLbl.TextSize = 11
	tLbl.TextColor3 = accent
	tLbl.TextXAlignment = Enum.TextXAlignment.Left
	tLbl.Text = tostring(title)
	tLbl.ZIndex = 72
	tLbl.Parent = card

	local mLbl = Instance.new("TextLabel")
	mLbl.Size = UDim2.new(1, -22, 0, 32)
	mLbl.Position = UDim2.new(0, 16, 0, 25)
	mLbl.BackgroundTransparency = 1
	mLbl.Font = Enum.Font.GothamBold
	mLbl.TextSize = 10
	mLbl.TextColor3 = Pal.Txt
	mLbl.TextWrapped = true
	mLbl.TextXAlignment = Enum.TextXAlignment.Left
	mLbl.TextYAlignment = Enum.TextYAlignment.Top
	mLbl.Text = tostring(msg)
	mLbl.ZIndex = 72
	mLbl.Parent = card

	task.delay(3.8, function()
		if card and card.Parent then
			local tw = TweenService:Create(card, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
			tw:Play()
			task.wait(0.26)
			if card and card.Parent then card:Destroy() end
		end
	end)
end

