end)

Players.PlayerAdded:Connect(function()
	if State.Esp then
		task.wait(0.8)
		RebuildEsp()
	end
end)

Players.PlayerRemoving:Connect(function()
	if State.Esp then
		task.wait(0.2)
		RebuildEsp()
	end
end)

RunService.Heartbeat:Connect(function()
	if State.Noclip then
		for _, p in ipairs(NoclipCache) do
			if p and p.Parent then
				p.CanCollide = false
			end
		end
	end
end)

local elapsedLoad = 0
local totalLoadTime = 5.4
local holoClock = 0

local loadConn
loadConn = RunService.RenderStepped:Connect(function(dt)
	holoClock += dt

	if LoadScreen and LoadScreen.Parent then
		-- Escáner láser vertical y barrido de radar
		local sweepPhase = (math.sin(holoClock * 2.2) + 1) * 0.5
		ScanBeam.Position = UDim2.new(0, 0, sweepPhase, 0)
		RadarSweep.Rotation = (holoClock * 150) % 360
		local pulseScale = 0.88 + math.sin(holoClock * 3.5) * 0.12
		RadarRing.Size = UDim2.new(0, math.floor(170 * pulseScale), 0, math.floor(170 * pulseScale))
		RadarRing.Position = UDim2.new(0.5, -math.floor(85 * pulseScale), 0.5, -math.floor(85 * pulseScale))
		HoloStroke.Color = (math.floor(holoClock * 2) % 2 == 0) and Pal.Cyan or Pal.Violet

		elapsedLoad += dt
		local pct = math.clamp(elapsedLoad / totalLoadTime, 0, 1)
		Bar3DFill.Size = UDim2.new(pct, 0, 1, 0)
		HoloPct.Text = math.floor(pct * 100) .. "%"

		if pct < 0.3 then
			HoloStage.Text = "Escaneando entorno y juego..."
		elseif pct < 0.65 then
			HoloStage.Text = "Inicializando Aimbot, TP, ESP y utilidades..."
		else
			HoloStage.Text = "Preparando barrera de Keys y 35 toques..."
		end

		if pct >= 1 then
			loadConn:Disconnect()
			LoadScreen:Destroy()
			KeyWin.Visible = true
			Notify(SCRIPT_NAME, "Listo en " .. GameTitle .. " • Escribe tu Key y PIN", Pal.Cyan)
		end
	else
		if loadConn then loadConn:Disconnect() end
	end

	if KeyWin and KeyWin.Visible and KeySystem.TapStart and KeySystem.TapCount < KeySystem.TapGoal then
		local elapsedT = os.clock() - KeySystem.TapStart
		if elapsedT > KeySystem.TapTimeLimit then
			ResetTapCounter("Se agotó el tiempo de los 35 toques")
			TapBtn.BackgroundColor3 = Pal.Card2
			TapBtn.TextColor3 = Pal.Gold
			TapBtn.Text = "TOCAR: 0 / 35  (30s)"
		else
			local rem = math.max(0, math.ceil(KeySystem.TapTimeLimit - elapsedT))
			TapBtn.Text = "TOCAR: " .. KeySystem.TapCount .. " / " .. KeySystem.TapGoal .. "  (" .. rem .. "s)"
		end
	end

	if State.Aimbot and KeySystem.Tier ~= "NONE" and Camera then
		local part = GetBestAimPart()
		if part then
			local goal = CFrame.lookAt(Camera.CFrame.Position, part.Position)
			local alpha = math.clamp(dt * (State.AimSmooth * 0.55), 0.04, 0.75)
			Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
		end
	end
end)
