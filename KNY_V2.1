-- =========================
-- SISTEMA DE KEYS + PIN + 35 TOQUES + RETO EXIGENTE (SIN AUTOLLENADO)
-- =========================
local KeySystem = {
	ActiveKeys = {},
	BurnedKeys = {},
	IssuedKeys = {},
	IssuedPins = {},
	TapGoal = 35,
	TapCount = 0,
	TapTimeLimit = 30,
	TapStart = nil,
	ChallengeA = 0,
	ChallengeB = 0,
	Tier = "NONE"
}

local function NewChallenge()
	KeySystem.ChallengeA = math.random(3, 12)
	KeySystem.ChallengeB = math.random(2, 9)
end
NewChallenge()

local function GenUniqueKey(tier)
	local chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
	local tag = (tier == "VIP") and "VIP" or "NORM"
	local code = ""
	repeat
		local s1, s2, s3 = "", "", ""
		for i = 1, 4 do
			s1 = s1 .. string.sub(chars, math.random(1, #chars), math.random(1, #chars))
			s2 = s2 .. string.sub(chars, math.random(1, #chars), math.random(1, #chars))
			s3 = s3 .. string.sub(chars, math.random(1, #chars), math.random(1, #chars))
		end
		code = "KNY-" .. tag .. "-" .. s1 .. "-" .. s2 .. "-" .. s3
	until not KeySystem.IssuedKeys[code] and not KeySystem.BurnedKeys[code]

	KeySystem.IssuedKeys[code] = true
	return code
end

local function GenUniquePin()
	local pin = ""
	repeat
		pin = string.format("%04d", math.random(0, 9999))
	until not KeySystem.IssuedPins[pin]

	KeySystem.IssuedPins[pin] = true
	return pin
end

local function CreateCredential(tier)
	local realTier = (tier == "VIP") and "VIP" or "NORMAL"
	local k = GenUniqueKey(realTier)
	local p = GenUniquePin()
	KeySystem.ActiveKeys[k] = {
		pin = p,
		tier = realTier
	}
	return k, p, realTier
end

local function BurnCredential(k)
	if not k or k == "" then return end
	KeySystem.BurnedKeys[k] = true
	KeySystem.ActiveKeys[k] = nil
end

local function ResetTapCounter(msg)
	KeySystem.TapCount = 0
	KeySystem.TapStart = nil
	if msg then
		Notify("35 TOQUES", msg, Pal.Red, true)
	end
end

